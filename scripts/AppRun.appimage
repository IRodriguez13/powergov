#!/bin/sh
# AppImage entry: GTK UI + optional in-app service install via pkexec.
APPDIR="$(dirname "$(readlink -f "$0")")"
export LD_LIBRARY_PATH="${APPDIR}/usr/lib:${LD_LIBRARY_PATH:-}"
export POWERGOV_ICON_ROOT="${APPDIR}/usr/share/icons/hicolor"
export POWERGOV_INSTALL_STAGING="${APPDIR}/usr/lib/powergov/staging"
export POWERGOV_INSTALL_HELPER="${APPDIR}/usr/libexec/powergov/install-service-resident.sh"
export POWERGOV_UNINSTALL_HELPER="${APPDIR}/usr/libexec/powergov/powergov-uninstall.sh"
export POWERGOV_USER_CLEANUP_HELPER="${APPDIR}/usr/libexec/powergov/remove-appimage-user-files.sh"
export POWERGOV_UPDATE_INSTALL_HELPER="${APPDIR}/usr/libexec/powergov/install-appimage-update.sh"

if [ -n "${APPIMAGE:-}" ] && [ -f "${APPIMAGE}" ] && [ "$(id -u)" -ne 0 ]; then
    DESKTOP_HELPER="${APPDIR}/usr/libexec/powergov/install-appimage-desktop.sh"
    if [ -x "${DESKTOP_HELPER}" ]; then
        "${DESKTOP_HELPER}" "${APPIMAGE}" "${APPDIR}" &
    fi
fi

UI="${APPDIR}/usr/bin/powergov-ui"

# Detach from the shell when launched interactively (closing the terminal must not kill the UI).
# Set POWERGOV_FG=1 to keep attached (debug / see stderr).
if [ -z "${POWERGOV_FG:-}" ] && [ -t 0 ] && [ -t 1 ]; then
    if command -v setsid >/dev/null 2>&1; then
        setsid "${UI}" "$@" </dev/null >/dev/null 2>&1 &
    else
        nohup "${UI}" "$@" </dev/null >/dev/null 2>&1 &
    fi
    exit 0
fi

exec "${UI}" "$@"
